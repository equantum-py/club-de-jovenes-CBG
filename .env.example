# Google Service Account email (Credentials JSON -> client_email)
GOOGLE_CLIENT_EMAIL="service-account@project.iam.gserviceaccount.com"

# Google Service Account private key (Credentials JSON -> private_key)
# En Vercel se puede pegar con saltos de línea reales o con \n escapados.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Spreadsheet ID de Google Sheets (la parte entre /d/ y /edit en la URL)
GOOGLE_SHEET_ID="spreadsheet_id"

# Panel administrativo (configurar solamente en Vercel, nunca subir valores reales a GitHub)
ADMIN_EMAIL="admin@ejemplo.com"
ADMIN_PASSWORD="una-clave-segura"
ADMIN_SESSION_SECRET="cadena-aleatoria-larga-y-segura"
